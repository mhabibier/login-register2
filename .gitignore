# ========================
# ArgonAuth — .gitignore
# ========================

# Jangan push file konfigurasi yang berisi kredensial sensitif
# (Uncomment baris di bawah jika ingin mengecualikan database.php)
# database.php

# File environment / konfigurasi lokal
.env
config.local.php

# Log files
*.log
logs/

# Cache
cache/
*.cache

# Dependency managers
vendor/
node_modules/

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*.bak

# SSL Certificates (jangan push private key ke GitHub!)
ssl/
*.pem
*.key
*.crt

# Logo asli (sudah di-copy ke assets/logo.png)
Logo_Argon.png

# Snort - log dan alert files (jangan push ke GitHub)
snort/log/
snort_logs/
*.pcap
*.log2
alert.log
snort.log*

# Snort - Community rules hasil download (auto-generated, jangan di-push)
# File ini didownload otomatis oleh entrypoint.sh saat container start
snort/rules/emerging-*.rules
snort/rules/.community_rules_meta
snort/rules/.last_update
