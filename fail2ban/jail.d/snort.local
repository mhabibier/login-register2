[DEFAULT]
bantime = 3600
findtime = 600
maxretry = 3
banaction = iptables-allports

[snort]
enabled = true
filter = snort
logpath = /var/log/snort/alert
backend = polling
maxretry = 1
bantime = 86400
# PENTING: Karena serangan berasal dari container ke container (jaringan Docker bridge),
# trafik melewati chain FORWARD (DOCKER-USER), BUKAN chain INPUT.
action = iptables-allports[name=snort, chain=DOCKER-USER]
