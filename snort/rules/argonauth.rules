# ============================================================
# ArgonAuth Custom Snort Rules
# Keamanan Sistem | Tel-U | NIM: 101032300005
#
# Kategori:
#   1. ICMP Attack (ping flood, ping of death, ICMP scan)
#   2. Port Scan
#   3. Brute Force Login
#   4. SQL Injection
#   5. XSS
#   6. Akses File Sensitif
#   7. Directory Traversal
#   8. Scanner Tools
# ============================================================

# ============================================================
# KATEGORI 1: ICMP Attack
# ============================================================

# Rule 1.1 — ICMP Ping biasa (monitor)
alert icmp $EXTERNAL_NET any -> $HOME_NET any \
    (msg:"ICMP - Echo Request (Ping) Detected"; \
     itype:8; icode:0; \
     classtype:misc-activity; \
     sid:1000070; rev:1;)

# Rule 1.2 — ICMP Ping Flood (>50 ping dalam 5 detik = serangan)
alert icmp $EXTERNAL_NET any -> $HOME_NET any \
    (msg:"ICMP - Ping Flood Attack Detected"; \
     itype:8; \
     threshold: type threshold, track by_src, count 50, seconds 5; \
     classtype:attempted-dos; \
     sid:1000071; rev:2;)

# Rule 1.3 — ICMP Ping of Death (paket ICMP oversized)
alert icmp $EXTERNAL_NET any -> $HOME_NET any \
    (msg:"ICMP - Ping of Death (Oversized ICMP Packet)"; \
     itype:8; dsize:>1024; \
     classtype:attempted-dos; \
     sid:1000072; rev:1;)

# Rule 1.4 — ICMP Destination Unreachable (network recon)
alert icmp any any -> $HOME_NET any \
    (msg:"ICMP - Destination Unreachable (Possible Recon)"; \
     itype:3; \
     threshold: type threshold, track by_src, count 10, seconds 10; \
     classtype:attempted-recon; \
     sid:1000073; rev:1;)

# Rule 1.5 — ICMP Time Exceeded (TTL expired, traceroute)
alert icmp any any -> $HOME_NET any \
    (msg:"ICMP - Time Exceeded (Possible Traceroute)"; \
     itype:11; \
     threshold: type threshold, track by_src, count 5, seconds 5; \
     classtype:attempted-recon; \
     sid:1000074; rev:1;)

# ============================================================
# KATEGORI 2: Port Scan Detection
# ============================================================

# Rule 2.1 — TCP SYN Scan (Nmap default)
alert tcp $EXTERNAL_NET any -> $HOME_NET any \
    (msg:"PORTSCAN - TCP SYN Scan (Possible Nmap)"; \
     flags:S; \
     threshold: type threshold, track by_src, count 15, seconds 2; \
     classtype:attempted-recon; \
     sid:1000001; rev:2;)

# Rule 2.2 — TCP NULL Scan (semua flag off)
alert tcp $EXTERNAL_NET any -> $HOME_NET any \
    (msg:"PORTSCAN - TCP NULL Scan Detected"; \
     flags:0; \
     classtype:attempted-recon; \
     sid:1000002; rev:1;)

# Rule 2.3 — TCP FIN Scan
alert tcp $EXTERNAL_NET any -> $HOME_NET any \
    (msg:"PORTSCAN - TCP FIN Scan Detected"; \
     flags:F; \
     threshold: type threshold, track by_src, count 10, seconds 2; \
     classtype:attempted-recon; \
     sid:1000003; rev:1;)

# Rule 2.4 — TCP XMAS Scan (FIN+URG+PSH)
alert tcp $EXTERNAL_NET any -> $HOME_NET any \
    (msg:"PORTSCAN - TCP XMAS Scan Detected"; \
     flags:FUP; \
     classtype:attempted-recon; \
     sid:1000004; rev:1;)

# Rule 2.5 — Koneksi ke banyak port dalam waktu cepat (port sweep)
alert tcp $EXTERNAL_NET any -> $HOME_NET 1:1024 \
    (msg:"PORTSCAN - Port Sweep on Well-Known Ports"; \
     flags:S; \
     threshold: type threshold, track by_src, count 20, seconds 3; \
     classtype:attempted-recon; \
     sid:1000005; rev:1;)

# ============================================================
# KATEGORI 3: Brute Force Login
# ============================================================

# Rule 3.1 — Brute Force POST ke login.php
alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS \
    (msg:"BRUTE FORCE - Multiple Login Attempts on login.php"; \
     flow:to_server,established; \
     content:"POST"; \
     content:"/login.php"; \
     threshold: type threshold, track by_src, count 5, seconds 60; \
     classtype:attempted-user; \
     sid:1000010; rev:2;)

# Rule 3.2 — Spam Registrasi
alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS \
    (msg:"BRUTE FORCE - Spam Registration on registrasi.php"; \
     flow:to_server,established; \
     content:"POST"; \
     content:"/registrasi.php"; \
     threshold: type threshold, track by_src, count 10, seconds 120; \
     classtype:attempted-user; \
     sid:1000011; rev:1;)

# ============================================================
# KATEGORI 4: SQL Injection
# ============================================================

# Rule 4.1 — UNION SELECT
alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS \
    (msg:"SQL INJECTION - UNION SELECT Detected"; \
     flow:to_server,established; \
     content:"UNION"; nocase; \
     content:"SELECT"; nocase; \
     classtype:web-application-attack; \
     sid:1000020; rev:2;)

# Rule 4.2 — OR 1=1 auth bypass
alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS \
    (msg:"SQL INJECTION - OR 1=1 Boolean Bypass"; \
     flow:to_server,established; \
     content:"or 1=1"; nocase; \
     classtype:web-application-attack; \
     sid:1000021; rev:1;)

# Rule 4.3 — DROP TABLE
alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS \
    (msg:"SQL INJECTION - DROP TABLE Destructive Query"; \
     flow:to_server,established; \
     content:"DROP TABLE"; nocase; \
     classtype:web-application-attack; \
     sid:1000022; rev:1;)

# ============================================================
# KATEGORI 5: XSS
# ============================================================

# Rule 5.1 — Script tag
alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS \
    (msg:"XSS - Script Tag in HTTP Request"; \
     flow:to_server,established; \
     content:"<script"; nocase; \
     classtype:web-application-attack; \
     sid:1000030; rev:2;)

# Rule 5.2 — javascript: protocol
alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS \
    (msg:"XSS - javascript: Protocol Injection"; \
     flow:to_server,established; \
     content:"javascript:"; nocase; \
     classtype:web-application-attack; \
     sid:1000031; rev:1;)

# ============================================================
# KATEGORI 6: Akses File Sensitif
# ============================================================

alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS \
    (msg:"SENSITIVE FILE - Access to .sql file"; \
     flow:to_server,established; \
     content:".sql"; nocase; \
     classtype:policy-violation; \
     sid:1000040; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS \
    (msg:"SENSITIVE FILE - Access to .env file"; \
     flow:to_server,established; \
     content:"/.env"; \
     classtype:policy-violation; \
     sid:1000041; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS \
    (msg:"SENSITIVE DIR - Access to .git directory"; \
     flow:to_server,established; \
     content:"/.git/"; \
     classtype:policy-violation; \
     sid:1000042; rev:1;)

# ============================================================
# KATEGORI 7: Directory Traversal
# ============================================================

alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS \
    (msg:"TRAVERSAL - Directory Traversal (../)"; \
     flow:to_server,established; \
     content:"../"; \
     classtype:web-application-attack; \
     sid:1000050; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS \
    (msg:"TRAVERSAL - Encoded Traversal (%2e%2e)"; \
     flow:to_server,established; \
     content:"%2e%2e"; nocase; \
     classtype:web-application-attack; \
     sid:1000051; rev:1;)

# ============================================================
# KATEGORI 8: Scanner Tools
# ============================================================

alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS \
    (msg:"SCANNER - sqlmap Tool Detected"; \
     flow:to_server,established; \
     content:"sqlmap"; nocase; \
     classtype:attempted-recon; \
     sid:1000060; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS \
    (msg:"SCANNER - Nikto Web Scanner Detected"; \
     flow:to_server,established; \
     content:"Nikto"; nocase; \
     classtype:attempted-recon; \
     sid:1000061; rev:1;)
